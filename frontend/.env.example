# URL of your deployed/running backend API (see backend/.env.example).
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Used by the "Sign in with Google" button (see components/auth/OAuthButtons.tsx).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# NOTE: This app's auth hooks (useAuth/useUser/useClerk in lib/auth-context.tsx)
# are named after Clerk but are a hand-rolled localStorage+JWT system that
# talks to this app's own backend — no ClerkProvider is configured, and no
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is read anywhere. The one real Clerk
# component (components/auth/SSOCallbackClient.tsx, at /sso-callback) will
# throw at runtime if it's ever rendered, since it needs a live
# ClerkProvider that doesn't exist. See the project review for the two
# ways to resolve this (finish migrating to real Clerk, or remove the
# dead Clerk code/dependency).
