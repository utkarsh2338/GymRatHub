# --- Database ---
# Local Docker Compose: MONGODB_URI=mongodb://mongo:27017/gymrathub
# Atlas (production):
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gymrathub

# --- Auth ---
# Signs and verifies session tokens issued by /api/auth/{register,login,google}.
# Required — the server refuses to start without it (see src/middleware/auth.ts).
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- CORS ---
# Comma-separated list of extra allowed frontend origins beyond localhost
# and *.vercel.app (both are always allowed). Example: your custom domain.
FRONTEND_URL=https://your-production-domain.com

# --- Third-party APIs ---
YOUTUBE_API_KEY=
# Optional. Powers the natural-language coaching narrative in
# GET /api/insights/coach. Without it, that endpoint still works and
# returns a templated (non-LLM) summary of the same structured data.
ANTHROPIC_API_KEY=

# --- Server ---
PORT=5000

# --- Redis ---
# Used by BullMQ for background notification queues.
# Defaults to local Redis; queue falls back to in-memory if Redis is unreachable.
REDIS_URL=redis://127.0.0.1:6379

# --- Email (Resend) ---
# Optional. Background email queue uses Resend for delivery.
# Without it, emails are logged to stdout (mock mode).
RESEND_API_KEY=re_DjoWSF5r_dSBHVN5fLT5bNQonSWywE8ML

# --- Stripe Billing ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_ELITE_MONTHLY_PRICE_ID=price_...
STRIPE_ELITE_ANNUAL_PRICE_ID=price_...

# --- Error Tracking (Sentry) ---
# Optional. Without a DSN, Sentry is silently disabled.
SENTRY_DSN=

# --- File Storage (Cloudinary) ---
# Used for progress photo uploads. See FILE_STORAGE.md for details.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
